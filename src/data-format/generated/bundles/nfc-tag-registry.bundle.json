{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfcweb.ai.studio/schemas/nfc-tag-registry/v1",
  "title": "NfcTagRegistryV1",
  "description": "Canonical v1 interchange format for the NFCWeb NFC tag registry backup and migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "appVersion",
    "tags"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "nfcweb-tag-registry",
      "description": "Identifier of the data interchange format."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Interchange schema specification version. Incremented only for breaking schema changes."
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of export generation."
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Application release version recorded at export time for provenance."
    },
    "tags": {
      "type": "array",
      "description": "Collection of NFC tag registry entries.",
      "items": {
        "$ref": "https://nfcweb.ai.studio/schemas/nfc-tag/v1"
      }
    }
  },
  "$defs": {
    "nfc-tag": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nfcweb.ai.studio/schemas/nfc-tag/v1",
      "title": "NfcTagV1",
      "description": "Canonical representation of a managed NFC tag entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "firstSeen",
        "lastRead",
        "readCount",
        "hasNdef",
        "records"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){4,16}$",
          "description": "Canonical lowercase hexadecimal UID representation without separators (e.g. 045ab23c9d8001).",
          "examples": [
            "045ab23c9d8001",
            "04881f6a229002",
            "012e3d4c5b6a7b8c"
          ]
        },
        "name": {
          "type": "string",
          "description": "Optional user-assigned name or nickname for the tag."
        },
        "firstSeen": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch timestamp in milliseconds when the tag was first discovered."
        },
        "lastRead": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch timestamp in milliseconds of the most recent read or write interaction."
        },
        "readCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of times this tag has been read or accessed."
        },
        "lastAction": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "erase"
          ],
          "description": "Most recent action performed with this tag in NFCWeb."
        },
        "tagType": {
          "type": "string",
          "description": "Hardware IC chip hint (e.g. NTAG213, MIFARE Ultralight, FeliCa)."
        },
        "hasNdef": {
          "type": "boolean",
          "description": "Whether the tag has active formatted NDEF records."
        },
        "records": {
          "type": "array",
          "description": "Array of NDEF records stored on this tag.",
          "items": {
            "$ref": "https://nfcweb.ai.studio/schemas/ndef-record/v1"
          }
        },
        "notes": {
          "type": "string",
          "description": "Optional user notes or remarks."
        }
      }
    },
    "ndef-record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nfcweb.ai.studio/schemas/ndef-record/v1",
      "title": "NdefRecordV1",
      "description": "Discriminated union of supported NDEF record types.",
      "oneOf": [
        {
          "$ref": "#text"
        },
        {
          "$ref": "#url"
        },
        {
          "$ref": "#mime"
        },
        {
          "$ref": "#empty"
        }
      ],
      "$defs": {
        "TextRecord": {
          "$anchor": "text",
          "type": "object",
          "title": "TextRecordV1",
          "description": "NDEF Well-Known Text record (T).",
          "additionalProperties": false,
          "required": [
            "id",
            "recordType",
            "data"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique identifier for this record."
            },
            "recordType": {
              "type": "string",
              "const": "text",
              "description": "Record type discriminator for text."
            },
            "data": {
              "type": "string",
              "description": "Text payload content."
            },
            "lang": {
              "type": "string",
              "description": "Language code (e.g. ja, en)."
            },
            "encoding": {
              "type": "string",
              "description": "Text character encoding (e.g. utf-8)."
            }
          }
        },
        "UrlRecord": {
          "$anchor": "url",
          "type": "object",
          "title": "UrlRecordV1",
          "description": "NDEF Well-Known URI/URL record (U).",
          "additionalProperties": false,
          "required": [
            "id",
            "recordType",
            "data"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique identifier for this record."
            },
            "recordType": {
              "type": "string",
              "const": "url",
              "description": "Record type discriminator for URI/URL."
            },
            "data": {
              "type": "string",
              "description": "Web URL or URI target string."
            }
          }
        },
        "MimeRecord": {
          "$anchor": "mime",
          "type": "object",
          "title": "MimeRecordV1",
          "description": "NDEF MIME media type record.",
          "additionalProperties": false,
          "required": [
            "id",
            "recordType",
            "data",
            "mediaType"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique identifier for this record."
            },
            "recordType": {
              "type": "string",
              "const": "mime",
              "description": "Record type discriminator for MIME content."
            },
            "data": {
              "type": "string",
              "description": "MIME payload string (e.g. serialized JSON, vCard)."
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "description": "IANA MIME media type specification (e.g. application/json, text/vcard)."
            }
          }
        },
        "EmptyRecord": {
          "$anchor": "empty",
          "type": "object",
          "title": "EmptyRecordV1",
          "description": "NDEF Empty record.",
          "additionalProperties": false,
          "required": [
            "id",
            "recordType"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique identifier for this record."
            },
            "recordType": {
              "type": "string",
              "const": "empty",
              "description": "Record type discriminator for empty record."
            },
            "data": {
              "type": "string",
              "description": "Empty payload string (optional, typically empty string)."
            }
          }
        }
      }
    }
  }
}
